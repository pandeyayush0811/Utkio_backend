# Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://pwdglktwuquoswqoyely.supabase.co
SUPABASE_ANON_KEY=eyJhMiOiJzdXBhYm6ImFub24iLCJpYXQiOjE3ODU2MTYyODAsImV4cCI6MjEwMTE5MjI4MH0.GdwAJAXx8x98QvkvW1HAZh7F3PIZiV3Uqeoqm54ohRo

# Service role key -> same page, "service_role" secret.
# NEVER put this in the frontend/app. Server-only. Used to read/write
# the profiles table bypassing RLS (e.g. auto-creating a profile row on signup).
SUPABASE_SERVICE_ROLE_KEY=eyJJlZiI6InB3ZGdsa3R3dXF1b3N3cW95ZWx5Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4NTYxNjI4MCwiZXhwIjoyMTAxMTkyMjgwfQ.MK4Z6dUiiHGtWUhlB_-qYwNpB-pbYSN44UiV5V2WBl4

PORT=3000

# Optional — error monitoring. Leave blank for local dev; the app runs
# fine without it, errors just won't get reported anywhere.
# Get a free DSN at https://sentry.io -> create a Node/Express project.
SENTRY_DSN=

# Server's OWN OpenAI key — used only for the chat-analysis feature.
# Different from the user's BYOK key (which never touches the backend).
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional — overrides the model used for the post-session analysis
# report. Defaults to gpt-4.1 if not set. Change this without a code
# deploy if OpenAI deprecates the default or you want to try another model.
ANALYSIS_MODEL=

# Optional — comma-separated list of origins allowed to call this API
# from a browser/WebView. Defaults to the native app's own origins
# (capacitor://localhost, ionic://localhost, http://localhost) if not
# set. Add your deployed web origin here once you have one, e.g.:
# ALLOWED_ORIGINS=capacitor://localhost,ionic://localhost,https://app.uktio.com
ALLOWED_ORIGINS=

# Optional — only needed once you run 2+ backend instances behind a
# load balancer. Leave blank for a single instance (the default) — the
# rate limiter uses a plain in-memory counter, no Redis required.
# Once you scale horizontally, set this to a reachable Redis instance
# (e.g. Upstash, Render Key Value, Railway Redis) and every instance
# will share the same rate-limit counters instead of counting separately.
# REDIS_URL=redis://user:password@your-redis-host:6379
REDIS_URL=
