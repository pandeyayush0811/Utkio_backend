# Copy this file to .env and fill in real values for local dev.
# In production (Render, etc.), set these in the host's env var settings instead.

# ── Required ──────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Required for anything that writes to profiles/chat_sessions/payments/etc.
# (onboarding, profile edits, session save, analysis, payments). Missing
# this makes those routes return a clear 500 instead of a confusing crash
# — never expose this key to the frontend/app, server-only.
SUPABASE_SERVICE_ROLE_KEY=

# ── Analysis report (OpenAI) ─────────────────────────────────────
OPENAI_API_KEY=

# Optional — overrides the model used for the post-session analysis
# report. Defaults to gpt-4.1 if not set. Change this without a code
# deploy if OpenAI deprecates the default or you want to try another model.
ANALYSIS_MODEL=

# ── Payments (Razorpay) ───────────────────────────────────────────
# From Razorpay Dashboard -> Settings -> API Keys. Use TEST mode keys
# while developing — they look the same shape but start with rzp_test_
# instead of rzp_live_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# From Razorpay Dashboard -> Settings -> Webhooks, when you create the
# webhook pointing at https://<your-backend>/payments/webhook. This is
# a DIFFERENT secret from RAZORPAY_KEY_SECRET above — don't reuse it.
RAZORPAY_WEBHOOK_SECRET=

# ── Payment reconciliation ─────────────────────────────────────────
# Protects POST /admin/reconcile-payments (see routes/adminRoutes.js).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required if you want to trigger reconciliation at all (manually or via cron).
ADMIN_SECRET=

# Optional — if set to a number > 0, runs payment reconciliation
# automatically every N minutes inside this process (no external cron
# needed). Leave unset to rely on an external cron hitting
# POST /admin/reconcile-payments instead, or to disable reconciliation
# entirely. See index.js for details. Recommended: 15-30 for a
# single-instance deploy.
RECONCILE_INTERVAL_MINUTES=

# ── Optional ──────────────────────────────────────────────────────
PORT=3000

# Comma-separated list of origins allowed to call this API from a
# browser/WebView. Defaults to the native app's own origins
# (capacitor://localhost, ionic://localhost, http://localhost) if not
# set. Add your deployed web origin here once you have one, e.g.:
# ALLOWED_ORIGINS=capacitor://localhost,ionic://localhost,https://app.uktio.com
ALLOWED_ORIGINS=

# Error monitoring — leave unset for local dev, fine without it.
SENTRY_DSN=

# Shared rate-limit counters across multiple server instances. Leave
# unset for a single-instance deploy (falls back to in-memory, no
# Redis dependency at runtime).
REDIS_URL=
